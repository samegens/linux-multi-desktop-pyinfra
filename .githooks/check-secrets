#!/bin/bash
# Shared script to detect secrets using gitleaks, TruffleHog, and detect-secrets

# Check if tools are installed
if ! command -v gitleaks &> /dev/null; then
    echo "ERROR: gitleaks is not installed"
    echo "See: https://github.com/gitleaks/gitleaks#installing"
    exit 1
fi

if ! command -v trufflehog &> /dev/null; then
    echo "ERROR: trufflehog is not installed"
    echo "See: https://github.com/trufflesecurity/trufflehog#floppy_disk-installation"
    exit 1
fi

DETECT_SECRETS_PATH=~/python3-venv/pyinfra-latest/bin/detect-secrets
if [ ! -f "$DETECT_SECRETS_PATH" ]; then
    echo "ERROR: detect-secrets is not installed"
    echo "Run: ./prepare.sh"
    exit 1
fi

FOUND_SECRETS=0

# Run gitleaks on staged files
echo "Running gitleaks secret detection..."
if ! gitleaks protect --staged --verbose --redact; then
    echo "✗ Gitleaks found secrets!"
    FOUND_SECRETS=1
fi

# Run TruffleHog on staged files (entropy-based detection)
echo ""
echo "Running TruffleHog entropy-based detection..."
if ! trufflehog git file://. --since-commit HEAD --only-verified=false --json 2>/dev/null | grep -q .; then
    echo "✓ No high-entropy secrets detected"
else
    echo "✗ TruffleHog found potential secrets!"
    FOUND_SECRETS=1
fi

# Run detect-secrets (must be run from git root)
echo ""
echo "Running detect-secrets..."
cd "$(git rev-parse --show-toplevel)"
if ~/python3-venv/pyinfra-latest/bin/detect-secrets-hook --baseline .secrets.baseline $(git diff --cached --name-only); then
    echo "✓ No new secrets detected by detect-secrets"
else
    echo "✗ detect-secrets found new secrets!"
    FOUND_SECRETS=1
fi

if [ $FOUND_SECRETS -eq 0 ]; then
    echo ""
    echo "✓ No secrets detected"
    exit 0
else
    echo ""
    echo "========================================="
    echo "SECRETS DETECTED!"
    echo "========================================="
    echo ""
    echo "Please either:"
    echo "  1. Remove the secrets from the files"
    echo "  2. Encrypt sensitive values with privy (see pyinfra/vault.py) and move them into"
    echo "     desktop-secrets/secrets_data.py, not this repo"
    echo "  3. If this is a false positive, add it to:"
    echo "     - .gitleaks.toml (for gitleaks)"
    echo "     - .secrets.baseline (for detect-secrets)"
    echo ""
    exit 1
fi
